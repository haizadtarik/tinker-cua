# Backend only. Never commit .env or paste the key into the chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
PORT=4317
# Installed Google Chrome is launched normally, then managed through local CDP.
# chromium uses Playwright Chromium (`npx playwright install chromium`).
BROWSER_CHANNEL=chrome
MAX_ACTIONS=160
MAX_TURNS=90
MAX_RUNTIME_MS=720000
API_TIMEOUT_MS=60000
# Login is manual in the dedicated browser. GMAIL_USERNAME/PASSWORD are not used.
